# Copie para .env e preencha os segredos. Nunca versione .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:4200
POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
DEMO_PASSWORD=
TIME_ZONE=America/Sao_Paulo
CELERY_BROKER_URL=redis://redis:6379/0
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false
SMTP_TIMEOUT=15
SMTP_FROM_EMAIL=Agenda Regulatória <agenda@agenda.invalid>
NOTIFICATION_BASE_URL=http://localhost:8080

# Opcional para TLS PostgreSQL; local usa prefer. Intranet usa verify-full + CA.
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=
# Só habilitar após revisão do gateway privado que sobrescreve os headers.
TRUST_PROXY_HTTPS=false

# Private evidence uploads; outside DEBUG a clamd scanner is required.
EVIDENCE_MAX_FILE_BYTES=2097152
EVIDENCE_MAX_FILES=3
EVIDENCE_SCANNER_HOST=
EVIDENCE_SCANNER_PORT=3310
EVIDENCE_MAX_OCCURRENCE_BYTES=52428800
EVIDENCE_MAX_OCCURRENCE_FILES=30
