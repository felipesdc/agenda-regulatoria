# Provision through your corporate secret store; never commit .env.intranet.
BACKEND_IMAGE=
FRONTEND_IMAGE=
INTRANET_HOST=agenda.intranet
INTRANET_BIND=127.0.0.1
TLS_DIRECTORY=
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=agenda.intranet,backend
CSRF_TRUSTED_ORIGINS=https://agenda.intranet
TRUST_PROXY_HTTPS=true
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=agenda
POSTGRES_USER=agenda_app
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/etc/agenda/db-ca.pem
POSTGRES_CA_FILE=
POSTGRES_PASSWORD=
CELERY_BROKER_URL=redis://redis:6379/0
TIME_ZONE=America/Sao_Paulo
NOTIFICATION_BASE_URL=https://agenda.intranet
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
SMTP_FROM_EMAIL=

# Private evidence uploads; outside DEBUG a clamd scanner is required.
EVIDENCE_MAX_FILE_BYTES=2097152
EVIDENCE_MAX_FILES=3
EVIDENCE_SCANNER_HOST=
EVIDENCE_SCANNER_PORT=3310
EVIDENCE_MAX_OCCURRENCE_BYTES=52428800
EVIDENCE_MAX_OCCURRENCE_FILES=30
