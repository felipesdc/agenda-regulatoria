map $uri $asset_cache {
  default "no-store";
  ~*\.(?:js|css)$ "public, max-age=31536000, immutable";
}
server {
  listen 443 ssl;
  server_name ${INTRANET_HOST};
  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  root /usr/share/nginx/html;
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $backend_upstream http://backend:8000;
  client_max_body_size 12m;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy same-origin always;
  add_header Cache-Control $asset_cache always;
  add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'" always;
  location /api/ { proxy_pass $backend_upstream; proxy_set_header Host $host; proxy_set_header X-Agenda-Client-IP $remote_addr; proxy_set_header X-Forwarded-Proto https; }
  location /admin/ { proxy_pass $backend_upstream; proxy_set_header Host $host; proxy_set_header X-Agenda-Client-IP $remote_addr; proxy_set_header X-Forwarded-Proto https; }
  location /ready/ { proxy_pass $backend_upstream; proxy_set_header Host $host; proxy_set_header X-Agenda-Client-IP $remote_addr; proxy_set_header X-Forwarded-Proto https; }
  location /health/ { proxy_pass $backend_upstream; proxy_set_header Host $host; proxy_set_header X-Agenda-Client-IP $remote_addr; proxy_set_header X-Forwarded-Proto https; }
  location ~* \.(?:js|css)$ { try_files $uri =404; }
  location / { try_files $uri $uri/ /index.html; }
}
